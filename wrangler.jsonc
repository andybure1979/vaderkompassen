{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaderkompassen",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": { "APP_VERSION": "14.1.0b" }
}
