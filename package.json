{
  "name": "vaderkompassen",
  "version": "14.4.2",
  "private": true,
  "description": "Väderkompassen – beslutsstöd för dagens aktivitet",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "places:build": "node scripts/build-place-assets.mjs",
    "validate:places": "node scripts/validate-places.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:verify": "node scripts/verify-worker-version.mjs",
    "deploy:production": "npm run deploy && npm run deploy:verify",
    "loadtest": "node scripts/load-test.mjs",
    "dev": "wrangler dev",
    "build:web": "npm run places:build && node scripts/build-web.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "cap:copy": "npm run build:web && cap copy",
    "cap:sync": "npm run build:web && cap sync",
    "cap:ios": "npm run build:web && cap sync ios",
    "cap:android": "npm run build:web && cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "native:ios": "npm run cap:ios && npm run cap:open:ios",
    "native:android": "npm run cap:android && npm run cap:open:android",
    "build:android:debug": "npm run cap:android && cd android && ./gradlew assembleDebug",
    "build:android:bundle": "npm run cap:android && cd android && ./gradlew bundleRelease"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/ios": "8.5.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@supabase/supabase-js": "2.111.0",
    "leaflet": "1.9.4"
  }
}
